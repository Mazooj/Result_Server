{
  "name": "Result Server",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "user": "ubuntu",
  "install": "./.cursor/scripts/install.sh",
  "start": "./.cursor/scripts/start.sh",
  "terminals": [
    {
      "name": "web",
      "command": "cd /workspace && . .venv/bin/activate && uvicorn main:app --host 0.0.0.0 --port 8000"
    }
  ],
  "ports": [8000]
}
